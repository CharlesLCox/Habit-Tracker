pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  parameters {
    string(
      name: 'AWS_REGION',
      defaultValue: 'us-east-2',
      description: 'AWS region used for ECR and ECS'
    )
    string(
      name: 'AWS_CREDENTIALS_ID',
      defaultValue: 'aws-jenkins',
      description: 'Jenkins credential id for AWS credentials'
    )
    string(
      name: 'AWS_ACCOUNT_ID',
      defaultValue: '',
      description: 'Optional AWS account id (auto-detected when blank)'
    )
    string(
      name: 'ECR_REPOSITORY',
      defaultValue: 'task-tracker-frontend',
      description: 'ECR repository name'
    )
    string(
      name: 'ECS_CLUSTER',
      defaultValue: '',
      description: 'ECS cluster name'
    )
    string(
      name: 'ECS_SERVICE',
      defaultValue: '',
      description: 'ECS service name'
    )
    string(
      name: 'ECS_TASK_FAMILY',
      defaultValue: '',
      description: 'Task definition family used by your ECS service'
    )
    string(
      name: 'ECS_CONTAINER_NAME',
      defaultValue: '',
      description: 'Optional container name (required when task definition has multiple containers)'
    )
    string(
      name: 'IMAGE_TAG',
      defaultValue: '',
      description: 'Optional image tag (defaults to BUILD_NUMBER)'
    )
    booleanParam(
      name: 'WAIT_FOR_STABILITY',
      defaultValue: true,
      description: 'Wait for ECS service deployment to finish before pipeline completes'
    )
    booleanParam(
      name: 'RUN_FRONTEND_LINT',
      defaultValue: false,
      description: 'Run frontend lint before build'
    )
  }

  environment {
    CI = 'true'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Install') {
      steps {
        script {
          if (isUnix()) {
            sh 'npm ci'
          } else {
            bat 'npm ci'
          }
        }
      }
    }

    stage('Lint (Optional)') {
      when {
        expression { return params.RUN_FRONTEND_LINT }
      }
      steps {
        script {
          if (isUnix()) {
            sh 'npx eslint src'
          } else {
            bat 'npx eslint src'
          }
        }
      }
    }

    stage('Build Frontend') {
      steps {
        script {
          if (isUnix()) {
            sh 'npm run build'
          } else {
            bat 'npm run build'
          }
        }
      }
    }

    stage('Archive Frontend Dist') {
      steps {
        archiveArtifacts artifacts: 'dist/**', fingerprint: true
      }
    }

    stage('Deploy to ECS') {
      steps {
        withCredentials([[
          $class: 'AmazonWebServicesCredentialsBinding',
          credentialsId: params.AWS_CREDENTIALS_ID
        ]]) {
          script {
            def resolvedImageTag = params.IMAGE_TAG?.trim() ? params.IMAGE_TAG.trim() : env.BUILD_NUMBER
            def deployEnv = [
              "AWS_REGION=${params.AWS_REGION}",
              "AWS_ACCOUNT_ID=${params.AWS_ACCOUNT_ID}",
              "ECR_REPOSITORY=${params.ECR_REPOSITORY}",
              "ECS_CLUSTER=${params.ECS_CLUSTER}",
              "ECS_SERVICE=${params.ECS_SERVICE}",
              "ECS_TASK_FAMILY=${params.ECS_TASK_FAMILY}",
              "IMAGE_TAG=${resolvedImageTag}",
              "WAIT_FOR_STABILITY=${params.WAIT_FOR_STABILITY.toString()}"
            ]

            if (params.ECS_CONTAINER_NAME?.trim()) {
              deployEnv.add("ECS_CONTAINER_NAME=${params.ECS_CONTAINER_NAME}")
            }

            withEnv(deployEnv) {
              if (isUnix()) {
                sh '''
                  chmod +x scripts/deploy-ecs.sh
                  scripts/deploy-ecs.sh
                '''
              } else {
                powershell '.\\scripts\\deploy-ecs.ps1'
              }
            }
          }
        }
      }
    }
  }

  post {
    always {
      deleteDir()
    }
  }
}
